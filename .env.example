# Maintainer configuration reference. Supply secrets through the hosting platform.
# Restart to change Brain limits. aireload refreshes provider credentials/models.
DISCORD_TOKEN=
MONGO_URI=
MONGO_DB_NAME=lexus_bot
PORT=10000
API_SECRET_KEY=
LAVALINK_URI=
LAVALINK_PASSWORD=

# Existing external chain: Groq first, Gemini fallback. Keys are optional for Brain.
AI_EXTERNAL_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Short, tool-free casual replies. Set empty to use GROQ_MODEL for all replies.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_EXTERNAL_CALL_LIMIT=200
AI_PROVIDER_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=300
AI_CODE_OUTPUT_TOKENS=2048

# Optional text-only loopback runtime; no model is downloaded or loaded by the bot.
AI_LOCAL_ENABLED=false
AI_LOCAL_URL=http://127.0.0.1:11434/v1
AI_LOCAL_MODEL=
AI_LOCAL_TIMEOUT=15

# Bounds and memory. Persistent addressed-chat history requires per-user opt-in.
AI_SQLITE_PATH=/home/container/data/lexus_ai.sqlite3
AI_MAX_CONCURRENT=8
AI_GUILD_CONCURRENT=3
AI_REQUEST_TIMEOUT=65
AI_CONTEXT_CHARS=10000
AI_PROMPT_CHARS=8000
AI_SESSION_TTL=900
AI_SESSION_COUNT=1000
AI_HISTORY_TTL=86400
AI_MEMORY_TTL=7776000

# Optional embeddings for explicitly ingested knowledge; conversation retrieval
# and knowledge: lookups do not send queries to an embedding provider.
AI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional live research fallback. No shared caching of personalized answers.
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Legacy typed evaluation API remains explicit; Brain does not call Jev to route.
AI_GATEWAY_API_KEY=
JEV_ENABLED=true
JEV_TOOL_GATE_ENABLED=false
